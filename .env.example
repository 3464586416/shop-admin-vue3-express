# ===== 数据库（本地 MySQL 或 TiDB Cloud Serverless 均可）=====
# TiDB Cloud 示例：
#   DB_HOST=gatewayXX.xxxx.free.cluster.local
#   DB_PORT=4000
#   DB_USER=<your-cluster-user>
#   DB_SSL=true
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=shop_db
DB_SSL=false

# ===== 安全 =====
# 必填！无默认值，未设置服务将拒绝启动。生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# 生产环境改为线上域名，多个用逗号分隔
CORS_ORIGIN=http://localhost:5173

# ===== 端口 =====
PORT=3000

# ===== 前端（一般不用改；同源部署时留空即可）=====
# VITE_API_BASE_URL=
